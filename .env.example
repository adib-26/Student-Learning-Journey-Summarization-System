# =============================================================================
# Environment configuration — copy to .env and fill in your values.
# =============================================================================

# DeepL Translation API (the only external API used)
DEEPL_API_KEY=your_deepl_api_key

# REST API security (required only when running `backend.app`). Generate two
# different high-entropy values and keep them out of source control.
# SECRET_KEY=
# JWT_SECRET_KEY=
# CORS_ORIGINS=http://localhost:8501
# API_DATABASE_PATH=data/api.sqlite3
# API_MAX_RECORDS=5000
# API_MAX_UPLOAD_BYTES=10485760
# API_SQLITE_BUSY_TIMEOUT_MS=5000

# Optional: provide this only when stable pseudonymous IDs are needed across
# restarts. Without it, the application uses a fresh process-local random salt.
# PII_HASH_SALT=

# PII-bearing report text is never cached. Static UI labels are memory-only by
# default; set a private JSON path only if their persistent cache is approved.
# TRANSLATION_CACHE_PATH=logs/translation_cache.json

# UI upload limit. This must not exceed Streamlit's server.maxUploadSize in
# .streamlit/config.toml without reviewing memory and OCR limits.
# APP_MAX_UPLOAD_BYTES=33554432

# -----------------------------------------------------------------------------
# Recommended M1/8 GB local inference: one shared MLX-VLM server.
# Start it with: bash scripts/start_mlx_vlm.sh
# It starts with no model loaded, then safely swaps Qwen and GLM-OCR through
# one local model cache. Do NOT start scripts/start_vllm.sh at the same time.
# -----------------------------------------------------------------------------
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_MODEL=mlx-community/Qwen2.5-3B-Instruct-4bit
# LLM_API_KEY=                       # only if the server runs with --api-key
# LLM_TIMEOUT_SECONDS=120
# LLM_MAX_RETRIES=2
# LLM_BREAKER_COOLDOWN_SECONDS=60
# LLM_MAX_TOKENS=320
# LLM_TEMPERATURE=0.3
# LLM_QUEUE_TIMEOUT_SECONDS=5       # serialises work for an 8 GB local model
# LLM_VALIDATE_NAMES=0               # legacy/direct callers only; unstructured Qwen extraction already returns the recipient
# LLM_EXTRACTION_MAX_DOCUMENT_CHARS=6500

# Shared MLX-VLM server profile (used by scripts/start_mlx_vlm.sh)
MLX_VLM_HOST=127.0.0.1
MLX_VLM_PORT=8000
MLX_VLM_VISION_CACHE_SIZE=1
MLX_VLM_PREFILL_STEP_SIZE=512
MLX_VLM_MAX_TOKENS=1024
MLX_VLM_MAX_KV_SIZE=4096
MLX_VLM_LOG_LEVEL=INFO
# Required for the locally cached GLM-OCR model.
MLX_VLM_TRUST_REMOTE_CODE=1
# MLX_VLM_PYTHON=                    # optional absolute path; default is ~/.venv-vllm-metal/bin/python

# Legacy vLLM-Metal alternative (not the recommended PDFs/images profile).
# Do not run it on the same port as the shared MLX-VLM server.
# VLLM_MAX_MODEL_LEN=4096
# VLLM_GPU_MEMORY_UTILIZATION=0.55
# VLLM_MAX_NUM_SEQS=1

# -----------------------------------------------------------------------------
# Local document OCR: GLM-OCR through the shared MLX-VLM endpoint above.
# This is active by default. It calls the loopback server, which unloads the
# current Qwen/GLM text model before switching, rather than retaining both.
# Downloads are deliberately disabled; both models must already be cached.
# -----------------------------------------------------------------------------
GLM_OCR_ENABLED=1
# http: scanned pages/images; http-force: visually OCR every PDF page.
GLM_OCR_MODE=http
GLM_OCR_BASE_URL=http://127.0.0.1:8000/v1
GLM_OCR_MODEL=mlx-community/GLM-OCR-bf16
GLM_OCR_TIMEOUT_SECONDS=180
GLM_OCR_HEALTH_TIMEOUT_SECONDS=1.5
# M1/8 GB-safe default; increase only after testing.
GLM_OCR_MAX_PAGES=1
# Total PDF pages considered (native + visual) before the evidence is marked incomplete.
GLM_OCR_MAX_TOTAL_PAGES=20
GLM_OCR_MAX_TOKENS=1024
GLM_OCR_RENDER_DPI=144
GLM_OCR_MAX_IMAGE_DIMENSION=1280
GLM_OCR_MAX_SOURCE_PIXELS=40000000
# Reject a larger source rather than risking a unified-memory spike.
GLM_OCR_MAX_DOCUMENT_BYTES=33554432
GLM_OCR_NATIVE_MIN_CHARS=40
GLM_OCR_ALLOW_MODEL_DOWNLOAD=0
# Never send student documents off-device.
GLM_OCR_ALLOW_REMOTE=0

# Explicit fallback only: use a short-lived local subprocess instead of the
# shared HTTP server. Leave the recommended GLM_OCR_MODE=http above unchanged
# unless diagnosing the shared server with every local Qwen/MLX service stopped.
# GLM_OCR_MODE=subprocess
# GLM_OCR_PYTHON=/absolute/path/to/vllm-metal/python
# On a 16 GB+ Mac only, an explicit override permits two local model processes.
# GLM_OCR_ALLOW_CONCURRENT_QWEN=1
