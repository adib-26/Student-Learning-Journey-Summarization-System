# =============================================================================
# Environment configuration — copy to .env and fill in your values.
# =============================================================================

# DeepL Translation API (optional external translation service)
DEEPL_API_KEY=your_deepl_api_key

# REST API security (required only when running `backend.app`). Generate two
# different high-entropy values and keep them out of source control.
# SECRET_KEY=
# JWT_SECRET_KEY=
# CORS_ORIGINS=http://localhost:8501
# API_DATABASE_PATH=data/api.sqlite3
# API_MAX_RECORDS=5000
# API_MAX_UPLOAD_BYTES=10485760
# API_SQLITE_BUSY_TIMEOUT_MS=5000

# Optional: provide this only when stable pseudonymous IDs are needed across
# restarts. Without it, the application uses a fresh process-local random salt.
# PII_HASH_SALT=

# PII-bearing report text is never cached. Static UI labels are memory-only by
# default; set a private JSON path only if their persistent cache is approved.
# TRANSLATION_CACHE_PATH=logs/translation_cache.json

# UI upload limit. This must not exceed Streamlit's server.maxUploadSize in
# .streamlit/config.toml without reviewing memory and OCR limits.
# APP_MAX_UPLOAD_BYTES=33554432

# -----------------------------------------------------------------------------
# Vertex AI Model Garden deployment. `scripts/vertex_deploy.py` writes these
# values after deployment. For an existing endpoint, copy its endpoint ID and
# dedicated DNS name from `gcloud ai endpoints describe`.
# Keep Google Application Default Credentials outside this repository.
# -----------------------------------------------------------------------------
VERTEX_PROJECT=your-project-id
VERTEX_REGION=us-central1
VERTEX_ENDPOINT_ID=your-endpoint-id
VERTEX_ENDPOINT_DNS=your-endpoint-dns.prediction.vertexai.goog
LLM_BASE_URL=https://YOUR_ENDPOINT_DNS/v1beta1/projects/YOUR_PROJECT_ID/locations/YOUR_REGION/endpoints/YOUR_ENDPOINT_ID
LLM_MODEL=qwen3.6-35b-a3b
# LLM_API_KEY=                       # not used for Vertex OAuth
# LLM_TIMEOUT_SECONDS=180
# LLM_MAX_RETRIES=2
# LLM_BREAKER_COOLDOWN_SECONDS=60
# LLM_MAX_TOKENS=768
# LLM_TEMPERATURE=0.1
# LLM_ENABLE_THINKING=0              # keep Qwen3.6 in concise instruct mode
# LLM_QUEUE_TIMEOUT_SECONDS=30
# LLM_VALIDATE_NAMES=0
# LLM_EXTRACTION_MAX_DOCUMENT_CHARS=12000

# -----------------------------------------------------------------------------
# Visual transcription through the same vLLM model and endpoint.
# Native PDF text remains preferred; only scanned/no-text pages use the GPU
# unless VLM_OCR_MODE=http-force is selected.
# -----------------------------------------------------------------------------
VLM_OCR_ENABLED=1
VLM_OCR_MODE=http
VLM_OCR_TIMEOUT_SECONDS=180
VLM_OCR_HEALTH_TIMEOUT_SECONDS=5
VLM_OCR_MAX_RETRIES=2
VLM_OCR_MAX_PAGES=4
VLM_OCR_MAX_TOTAL_PAGES=30
VLM_OCR_MAX_TOKENS=2048
VLM_OCR_RENDER_DPI=180
VLM_OCR_MAX_IMAGE_DIMENSION=2048
VLM_OCR_MAX_SOURCE_PIXELS=40000000
VLM_OCR_MAX_DOCUMENT_BYTES=67108864
VLM_OCR_NATIVE_MIN_CHARS=40
# Required so scanned documents may be sent to the Modal endpoint.
VLM_OCR_ALLOW_REMOTE=1
